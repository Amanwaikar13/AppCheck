# Copy this file to .env and replace the placeholders. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers).
# URL-encode special characters in the password (e.g. @ -> %40).
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/appcheck?retryWrites=true&w=majority

# Frontend origin(s) allowed by CORS. Separate multiple origins with commas.
FRONTEND_URL=http://localhost:3000

# Optional: DNS server IP(s) for resolving mongodb+srv:// records. Set this only if
# startup fails with "querySrv ECONNREFUSED" (e.g. DNS_SERVERS=8.8.8.8,1.1.1.1).
# DNS_SERVERS=

# Secret for signing session tokens (JWT, HS256). At least 32 characters; use a
# different random value per environment. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<generate-a-random-secret>

# Optional: session lifetime as <number><s|m|h|d> (default: 1h)
# JWT_EXPIRES_IN=1h

# Optional: bcrypt cost factor, 10-15 (default: 12)
# BCRYPT_SALT_ROUNDS=12

# Optional: fatal | error | warn | info | debug | trace | silent (default: info)
# LOG_LEVEL=info

# --- URL scanner (OWASP ZAP baseline in Docker) ---------------------------
# disabled (default): URL scans are accepted but stay queued.
# zap-docker: a background worker runs passive ZAP baseline scans.
# Requires Docker and: docker pull zaproxy/zap-stable
URL_SCANNER=disabled
# ZAP_DOCKER_IMAGE=zaproxy/zap-stable
# Interface for the per-scan egress proxy, and how the ZAP container reaches it.
# Docker Desktop: keep the defaults. Linux Docker Engine: use the docker0
# address for both (e.g. 172.17.0.1). Never bind to a public interface.
# SCANNER_PROXY_BIND=127.0.0.1
# SCANNER_PROXY_HOST=host.docker.internal
# DEVELOPMENT ONLY (rejected in production): local lab targets that may be
# scanned, as name.test=IP pairs, e.g. juice.lab.test=127.0.0.1
# SCANNER_LAB_TARGETS=
